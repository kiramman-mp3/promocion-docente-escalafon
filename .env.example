# Copia este archivo como .env y reemplaza los valores. El .env NUNCA se sube a git.
# SQL Server exige contraseñas de 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita comillas (' ") y espacios en las contraseñas.

# ---------- SQL Server (docker) ----------
MSSQL_SA_PASSWORD=CambiaEsto_Sa2026!
SQL_PORT=1433

# Login de solo lectura que usa la API
APP_DB_USER=app_uta
APP_DB_PASSWORD=CambiaEsto_App2026!

# true = carga datos de prueba (docentes, obras, evaluaciones...)
SEED_DATA=true

# ---------- API (.NET) ----------
# Host/puerto de SQL Server vistos desde la API. Con `dotnet run` local: localhost y SQL_PORT.
# Dentro de docker-compose la API usa sqlserver:1433 automáticamente.
DB_HOST=localhost

# Clave para firmar los JWT (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_KEY=CAMBIA_ESTO_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Puerto del host donde docker-compose publica la API
API_PORT=5270

# Puerto del host para el frontend (nginx)
FRONTEND_PORT=8080

# Intentos de inicio de sesión permitidos por minuto y por IP
LOGIN_RATE_LIMIT=10

# Días que se conservan los respaldos de la base (docker compose --profile operacion run --rm db-backup)
RETENCION_DIAS=30
