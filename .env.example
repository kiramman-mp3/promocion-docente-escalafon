# Copia este archivo como .env y reemplaza los valores. El .env NUNCA se sube a git.
# SQL Server exige contraseñas de 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita comillas (' ") y espacios en las contraseñas.

# ---------- SQL Server (docker) ----------
MSSQL_SA_PASSWORD=CambiaEsto_Sa2026!
SQL_PORT=1433

# Login de solo lectura que usa la API
APP_DB_USER=app_uta
APP_DB_PASSWORD=CambiaEsto_App2026!

# true = carga datos de prueba (docentes, obras, evaluaciones...)
SEED_DATA=true
